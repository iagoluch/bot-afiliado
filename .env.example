# Seguro por padrao: nenhuma publicacao externa ocorre com DRY_RUN=true.
DRY_RUN=true
DATABASE_PATH=data/affiliate.db
# HTTP local e aceito somente em DRY_RUN. Publicacao real exige URL HTTPS publica.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Bind local padrao. Para qualquer exposicao, use HTTPS em PUBLIC_BASE_URL e senha.
WEB_HOST=127.0.0.1
ADMIN_PASSWORD=

# Necessarios somente para publicacao REAL no Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# P1: pasta local de imagens/videos. No Lubuntu, use o caminho do ffmpeg instalado.
CREATIVES_PATH=data/creatives
FFMPEG_PATH=

# Instagram Graph API: todos os gates permanecem false por padrao.
# A base publica deve expor CREATIVES_PATH preservando o caminho relativo do MP4.
INSTAGRAM_MEDIA_BASE_URL=
INSTAGRAM_ASSET_ALLOWED_HOSTS=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REEL_CONTAINER_API_ENABLED=false
# Marque true somente apos confirmar conta profissional, Page vinculada e
# permissao instagram_content_publish no fluxo Facebook Login.
INSTAGRAM_FACEBOOK_LOGIN_READY=false
# media_publish permanece bloqueado: o contrato oficial acessivel nao oferece
# parametro confirmado para aplicar o rotulo de parceria paga exigido no afiliado.

# Acesso oficial Shopee Affiliate API. O P0 nao usa estes segredos enquanto
# o contrato brasileiro nao for validado no explorer autenticado.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Amazon Creators API: contrato mockado apenas. Uso real/import fica bloqueado
# ate aprovacao escrita e desenho de retencao aderente aos termos BR.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG_BR=

# Awin: credenciais distintas. O P2 importa feed local e nao usa estas chaves.
AWIN_FEED_API_KEY=
AWIN_PARTNER_API_TOKEN=
# Hosts de deeplink do programa, separados por virgula, quando o feed nao usa awin1.com.
AWIN_ALLOWED_AFFILIATE_HOSTS=
# Hosts de imagem do anunciante aprovados para download/render, separados por virgula.
AWIN_ALLOWED_IMAGE_HOSTS=

# Visibilidade e overrides opcionais de compliance. Valores sao objetos JSON.
CHANNEL_VISIBILITY_JSON={"site":"public","telegram":"public","instagram":"public","tiktok":"public"}
MERCHANT_CHANNEL_RULES_JSON={}

# IA local opcional para hook generico no ContentPackage e no copy-preview.
# Ollama deve escutar apenas em loopback; modelo recomendado para o Acer Lubuntu.
# Nenhum modelo e baixado automaticamente. Falha ou texto invalido usa template.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_LENGTH=1024
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=2m
OLLAMA_THINK=false
# Fallback opcional se Ollama estiver indisponivel e ambos os caminhos existirem.
LLAMA_CLI_PATH=
LLAMA_MODEL_PATH=

# Worker continuo: no DRY_RUN, o sample e a fonte local padrao quando vazio.
# Em modo real, configure WORKER_SOURCE_PATH somente apos aprovacoes externas.
WORKER_SOURCE_PATH=
WORKER_ADAPTER=shopee
WORKER_IDLE_SECONDS=30
WORKER_ERROR_BACKOFF_SECONDS=60
WORKER_LOCK_PATH=data/worker.lock
