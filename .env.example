# Seguro por padrao: nenhuma publicacao externa ocorre com DRY_RUN=true.
DRY_RUN=true
DATABASE_PATH=data/affiliate.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_HOST=127.0.0.1
WEB_PORT=8000
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CREATIVES_PATH=data/creatives
FFMPEG_PATH=

INSTAGRAM_MEDIA_BASE_URL=
INSTAGRAM_ASSET_ALLOWED_HOSTS=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REEL_CONTAINER_API_ENABLED=false
INSTAGRAM_FACEBOOK_LOGIN_READY=false

SHOPEE_APP_ID=
SHOPEE_SECRET=

AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG_BR=

AWIN_FEED_API_KEY=
AWIN_PARTNER_API_TOKEN=
AWIN_ALLOWED_AFFILIATE_HOSTS=
AWIN_ALLOWED_IMAGE_HOSTS=

CHANNEL_VISIBILITY_JSON={"site":"public","telegram":"public","instagram":"public","tiktok":"public"}
MERCHANT_CHANNEL_RULES_JSON={}

# IA opcional. Sem chave/modelo o bot usa TemplateProvider e continua funcional.
# Provider remoto principal: Gemini API. A chave fica somente no header HTTP.
AI_REMOTE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_REMOTE_TIMEOUT_SECONDS=12

# Dois erros/rejeicoes consecutivos pausam o provider por 5 minutos.
AI_CIRCUIT_FAILURES=2
AI_CIRCUIT_COOLDOWN_SECONDS=300

# Fallback local experimental: Granite GGUF via llama.cpp, DESLIGADO por padrao.
# Nao ative no Acer sem homologacao real de RAM/swap/latencia.
AI_LOCAL_ENABLED=false
GRANITE_CLI_PATH=
GRANITE_MODEL_PATH=
AI_LOCAL_TIMEOUT_SECONDS=20

WORKER_SOURCE_PATH=
WORKER_ADAPTER=shopee
WORKER_IDLE_SECONDS=30
WORKER_ERROR_BACKOFF_SECONDS=60
WORKER_LOCK_PATH=data/worker.lock
