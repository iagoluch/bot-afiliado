[Unit]
Description=BOT AFILIADO web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-@REPO_DIR@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_DIR@/.venv/bin/python -m uvicorn app.web:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
